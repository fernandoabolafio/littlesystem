{
  "name": "littlesystem",
  "version": "0.1.0",
  "description": "Sketch software systems on a canvas, and watch them run. Drive it from the CLI or your coding agent.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandoabolafio/littlesystem.git"
  },
  "homepage": "https://github.com/fernandoabolafio/littlesystem#readme",
  "bugs": {
    "url": "https://github.com/fernandoabolafio/littlesystem/issues"
  },
  "type": "module",
  "bin": {
    "littlesystem": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "licenses"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "packageManager": "pnpm@11.1.3",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm build:cli",
    "build:cli": "esbuild cli/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cli.js --loader:.md=text --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc -b",
    "cli": "node dist/cli.js",
    "preview": "vite preview",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.25.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semantic-release": "^25.0.9",
    "sucrase": "^3.35.1",
    "tldraw": "^5.5.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.2"
  }
}
